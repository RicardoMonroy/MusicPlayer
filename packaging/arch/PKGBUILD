pkgname=musicplayer
pkgver=0.1.0
pkgrel=1
pkgdesc='Cross-platform music player with desktop and terminal interfaces'
arch=('x86_64' 'aarch64')
url='https://github.com/RicardoMonroy/MusicPlayer'
license=('GPL-3.0-or-later')
depends=('mpv' 'yt-dlp' 'webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator' 'dbus' 'openssl')
makedepends=('rust' 'cargo' 'bun' 'git')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

build() {
  cd "$srcdir/MusicPlayer/apps/desktop"
  bun install --frozen-lockfile
  bun run tauri build --no-bundle -- --locked
  cd ../..
  cargo build --release --locked -p musicplayer-tui
}

package() {
  cd "$srcdir/MusicPlayer"
  install -Dm755 target/release/musicplayer-desktop "$pkgdir/usr/bin/musicplayer"
  install -Dm755 target/release/musicplayer-tui "$pkgdir/usr/bin/musicplayer-tui"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/musicplayer.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=MusicPlayer
Comment=Play local music and YouTube Music
Exec=musicplayer
Icon=musicplayer
Terminal=false
Categories=AudioVideo;Audio;Player;
DESKTOP
  local size
  for size in 32 128; do
    install -Dm644 "apps/desktop/src-tauri/icons/${size}x${size}.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/musicplayer.png"
  done
  install -Dm644 apps/desktop/src-tauri/icons/128x128@2x.png \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/musicplayer.png"
}
