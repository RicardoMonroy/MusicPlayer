{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicPlayer",
  "version": "0.1.0",
  "identifier": "dev.ricardo.musicplayer",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "MusicPlayer",
        "width": 1100,
        "height": 720,
        "label": "main"
      },
      {
        "label": "compact",
        "title": "MusicPlayer Mini",
        "url": "/compact",
        "width": 360,
        "height": 220,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "license": "GPL-3.0-or-later",
    "category": "Music",
    "shortDescription": "Local and YouTube Music player",
    "linux": {
      "deb": {
        "depends": ["libmpv2", "yt-dlp"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
